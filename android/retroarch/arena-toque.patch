+/* ARENA: com um controle de verdade ligado, o RetroArch esconde o controle de toque inteiro
+ * (input_overlay_hide_when_gamepad_connected) e nao havia como chegar ao SAIR, ao MENU e ao SALVAR pela tela (achado
+ * do Rafael no Bully, 07/11/2026). Dois toques rapidos na tela mostram o controle de toque; ele fica enquanto a tela e'
+ * tocada e some de novo 10 s depois do ultimo toque. Quem pergunta e' o runloop.c (arena_toque_a_vista). */
+#define ARENA_DOIS_TOQUES_US   400000
+#define ARENA_TOQUE_A_VISTA_US 10000000
+static retro_time_t arena_toque_ate     = 0;
+static retro_time_t arena_ultimo_toque  = 0;
+
+bool arena_toque_a_vista(void)
+{
+   return arena_toque_ate && cpu_features_get_time_usec() < arena_toque_ate;
+}
+
+static void arena_tocou_na_tela(void)
+{
+   retro_time_t agora = cpu_features_get_time_usec();
+   if (arena_toque_a_vista())
+      arena_toque_ate = agora + ARENA_TOQUE_A_VISTA_US;      /* usando os botoes da tela: continuam */
+   else if (arena_ultimo_toque && agora - arena_ultimo_toque < ARENA_DOIS_TOQUES_US)
+   {
+      arena_toque_ate = agora + ARENA_TOQUE_A_VISTA_US;      /* dois toques: aparecem */
+      RARCH_LOG("[ARENA] Dois toques na tela: o controle de toque aparece.\n");
+   }
+   arena_ultimo_toque = agora;
+}
+
