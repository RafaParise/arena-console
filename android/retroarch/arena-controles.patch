+/* ARENA: registra os controles que JA estao ligados na ordem em que foram CONECTADOS (o numero que o Android da a
+ * cada aparelho cresce a cada conexao), e nao na ordem do primeiro botao apertado: o primeiro controle ligado e'
+ * o jogador 1. Os que chegarem depois entram como sempre, no primeiro evento. So controles de jogo (gamepad ou
+ * joystick): teclado, tela de toque e o dispositivo "Virtual" (id negativo) ficam de fora. */
+static void android_input_arena_conectar_na_ordem(android_input_t *android,
+      struct android_app *android_app)
+{
+   jmethodID getDeviceIds   = NULL;
+   jmethodID getDevice      = NULL;
+   jmethodID getSources     = NULL;
+   jclass class             = NULL;
+   jintArray ids            = NULL;
+   jint lista[64];
+   int quantos              = 0;
+   int registrados          = 0;
+   int i, j;
+   JNIEnv *env              = (JNIEnv*)jni_thread_getenv();
+
+   if (!env)
+      return;
+
+   FIND_CLASS(env, class, "android/view/InputDevice");
+   if (!class)
+      return;
+
+   GET_STATIC_METHOD_ID(env, getDeviceIds, class, "getDeviceIds", "()[I");
+   GET_STATIC_METHOD_ID(env, getDevice, class, "getDevice",
+         "(I)Landroid/view/InputDevice;");
+   GET_METHOD_ID(env, getSources, class, "getSources", "()I");
+   if (!getDeviceIds || !getDevice || !getSources)
+      return;
+
+   ids = (jintArray)(*env)->CallStaticObjectMethod(env, class, getDeviceIds);
+   if (!ids)
+      return;
+
+   quantos = (int)(*env)->GetArrayLength(env, ids);
+   if (quantos > 64)
+      quantos = 64;
+   (*env)->GetIntArrayRegion(env, ids, 0, quantos, lista);
+   (*env)->DeleteLocalRef(env, ids);
+
+   /* em ordem crescente (o Android ja entrega assim; garante) */
+   for (i = 1; i < quantos; i++)
+   {
+      jint atual = lista[i];
+      for (j = i - 1; j >= 0 && lista[j] > atual; j--)
+         lista[j + 1] = lista[j];
+      lista[j + 1] = atual;
+   }
+
+   for (i = 0; i < quantos && android->pads_connected < MAX_USERS; i++)
+   {
+      jobject device = NULL;
+      jint fontes    = 0;
+      char nome[256];
+      int fabricante = 0;
+      int produto    = 0;
+      int porta      = -1;
+      int id         = (int)lista[i];
+
+      if (id < 0)
+         continue;
+
+      CALL_OBJ_STATIC_METHOD_PARAM(env, device, class, getDevice, (jint)id);
+      if (!device)
+         continue;
+      CALL_INT_METHOD(env, fontes, device, getSources);
+      (*env)->DeleteLocalRef(env, device);
+
+      if (   (fontes & AINPUT_SOURCE_GAMEPAD)  != AINPUT_SOURCE_GAMEPAD
+          && (fontes & AINPUT_SOURCE_JOYSTICK) != AINPUT_SOURCE_JOYSTICK)
+         continue;
+      if (android_input_get_id_port(android, id, 0) >= 0)
+         continue;
+      nome[0] = '\0';
+      if (   !engine_lookup_name(nome, &fabricante, &produto, sizeof(nome), id)
+          || strstr(nome, "Virtual"))
+         continue;
+
+      handle_hotplug(android, android_app, &porta, id, (int)fontes);
+      registrados++;
+   }
+
+   RARCH_LOG("[ARENA] Controles na ordem em que foram conectados: %d.\n", registrados);
+}
+
