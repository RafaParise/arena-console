# Arquivos grandes/temporários
*.zip
*.iso
*.7z
backup/
*.tmp
*.log

# Python
__pycache__/
*.pyc
*.pyo
.env

# IDE
.idea/
.vscode/
*.swp
*.swo

# Dados temporários
dados/*.json
dados/*.db
dados/*.cfg

# Mantém as pastas de código, interface e documentação
!launcher/
!servidor/

# Mantém documentação e arquivos de configuração
!*.py
!*.js
!*.css
!*.html
!*.json
!*.md
!*.bat

# Runtime pesado que não entra no git — copiar manualmente para rodar
# (Python embutido e o RetroArch inteiro; ver LEIA-ME.md)
servidor/python/
# O Python do Linux (ferramentas\preparar_linux.py poe no lugar)
servidor/python-linux/

# ---------------------------------------------------------------------------
# jogos/, emuladores/ e retroarch/: mantém só a estrutura de pastas vazias
# (o LEIA.txt de cada uma), ignora o conteúdo de verdade (ROMs, emuladores
# baixados, o RetroArch inteiro). Git não faz negação dentro de uma pasta
# já ignorada por inteiro, por isso o "/*" em cada nível em vez de só "/".
# ---------------------------------------------------------------------------

jogos/*
!jogos/livres/
!jogos/pessoais/
!jogos/turma/
jogos/livres/*
!jogos/livres/LEIA.txt
jogos/pessoais/*
!jogos/pessoais/LEIA.txt
jogos/turma/*
!jogos/turma/LEIA.txt

emuladores/*
!emuladores/LEIA.txt
!emuladores/PCSX2/
!emuladores/Dolphin/
!emuladores/RPCS3/
!emuladores/Xenia/
!emuladores/Java/
emuladores/PCSX2/*
!emuladores/PCSX2/LEIA.txt
emuladores/Dolphin/*
!emuladores/Dolphin/LEIA.txt
emuladores/RPCS3/*
!emuladores/RPCS3/LEIA.txt
emuladores/Xenia/*
!emuladores/Xenia/LEIA.txt
emuladores/Java/*
!emuladores/Java/LEIA.txt

retroarch/*
!retroarch/system/
!retroarch/cores/
!retroarch/states/
!retroarch/saves/
!retroarch/cheats/
!retroarch/remaps/
!retroarch/controles/
!retroarch/screenshots/
!retroarch/cache/
retroarch/system/*
!retroarch/system/LEIA.txt
retroarch/cores/*
!retroarch/cores/LEIA.txt
retroarch/states/*
!retroarch/states/LEIA.txt
retroarch/saves/*
!retroarch/saves/LEIA.txt
retroarch/cheats/*
!retroarch/cheats/LEIA.txt
retroarch/remaps/*
!retroarch/remaps/LEIA.txt
retroarch/controles/*
!retroarch/controles/LEIA.txt
retroarch/screenshots/*
!retroarch/screenshots/LEIA.txt
retroarch/cache/*
!retroarch/cache/LEIA.txt

# Dados do usuário (não commitar)
dados/*
!dados/LEIA.txt

# Coletas do perfil-alvo (COLETAR.bat): dados de maquinas, nao vao para o git
perfil/

# A pasta BIOS (servidor\bios.py): o ARENA cria as pastas e os LEIA sozinho
# ao abrir; o que vai dentro sao as BIOS de quem usa. Nada dela vai para o git.
BIOS/

# Programa pago da Steam (Lossless Scaling): o ARENA so usa o de quem comprou
# (servidor/lossless.py) e nunca leva junto -- nem no git, nem no pacote.
/Lossless Scaling/

# ARENA no navegador (o Chromebook, item 12): os nucleos do RetroArch para
# navegador (ferramentas\preparar_nucleos_navegador.py, uns 90 MB) e os jogos
# livres embutidos (ferramentas\montar_navegador.py, copia de testes\jogos_livres)
# vem no pacote, nao no git.
launcher/navegador/nucleos/*
!launcher/navegador/nucleos/LEIA.txt
launcher/navegador/livres.js

# O ADB oficial do Google (Platform Tools): o aluno descompacta aqui para o ARENA
# ler o celular ligado no cabo (servidor/adb_aparelho.py). E' do Google: nem no git,
# nem no pacote.
/platform-tools/

# Arquivos soltos na raiz que nao sao do ARENA (conversas, troca de recordes, copias de memoria do assistente): nunca vao
# para o repositorio publico (auditoria 5, SUP-02).
/ARENA-troca.json
/Conversa ARENA.txt
/$HOME/
/Script do claude code*.txt
/claude-legacy-project-memory-*.md

# O ViGEmClient.dll (gamepad Xbox virtual, opcional) nao vai ao repositorio publico: ferramentasaixar_vigem_client.py
servidor/vigem/*.dll
