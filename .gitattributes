# Finais de linha: o repositório guarda tudo com LF, e cada computador
# converte ao baixar (o Windows, com core.autocrlf, volta para CRLF).
* text=auto

# Os .bat e .ps1 do Windows precisam de CRLF mesmo baixados como .zip do
# GitHub ou por um computador que não é Windows: com LF, o cmd erra rótulo e
# GOTO no meio do ARENA.bat.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Os do Linux (item 13) precisam de LF mesmo baixados no Windows: com CRLF, o
# sh le "\r" no fim de cada linha e para no primeiro comando.
*.sh text eol=lf
*.desktop text eol=lf
Dockerfile text eol=lf

# BIOS livres e jogos livres dos testes: o ARENA e o conferidor conferem cada
# arquivo pela marca (SHA-256), byte a byte. Sem conversão de final de linha,
# senão o config.ini do C-BIOS baixado no Windows ganharia CRLF, a marca não
# bateria e o ARENA não instalaria a BIOS livre.
servidor/bios_livres/** -text
testes/jogos_livres/** -text

# Arquivos que nunca são texto.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.gif binary
*.zip binary
*.7z binary
*.dll binary
*.exe binary
*.db binary
